// Prisma Schema for BPKCH Hospital Complaint & Grievance Management System ("Gunaso Portal")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  GRIEVANCE_ADMIN
  DEPT_HEAD
  INVESTIGATOR
}

enum Category {
  MEDICAL_CARE
  STAFF_BEHAVIOR
  BILLING
  HYGIENE
  FACILITIES
  DELAY_IN_SERVICE
  PHARMACY
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Status {
  SUBMITTED
  UNDER_INVESTIGATION
  ACTION_TAKEN
  RESOLVED
  REJECTED
  ESCALATED
}

enum ActionType {
  STATUS_CHANGE
  ASSIGNMENT
  INTERNAL_NOTE
  ACTION_LOGGED
  PUBLIC_UPDATE
  ESCALATED
  CAPA_RECORDED
}

enum RootCauseCategory {
  PROCESS_DEFECT
  COMMUNICATION_GAP
  EQUIPMENT_FAILURE
  SUPPLY_SHORTAGE
  STAFFING_WORKLOAD
  INFRASTRUCTURE
  HUMAN_ERROR
  OTHER
}

enum CapaStatus {
  DRAFT
  PENDING_QA_REVIEW
  APPROVED_BY_QA
  CLOSED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(GRIEVANCE_ADMIN)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  actions      ComplaintAction[]
  assignedComplaints Complaint[] @relation("AssignedComplaints")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Patient {
  id           String      @id @default(cuid())
  name         String
  phone        String?     @unique
  email        String?     @unique
  passwordHash String
  complaints   Complaint[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Department {
  id         String      @id @default(cuid())
  nameEn     String
  nameNp     String
  code       String      @unique // e.g. "EMG", "ICU", "OPD", "BIL", "PHARM"
  slaHours   Int         @default(48)
  headUserId String?
  users      User[]
  units      Unit[]
  complaints Complaint[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Unit {
  id           String      @id @default(cuid())
  nameEn       String
  nameNp       String
  code         String      @unique // e.g. "OPD-CARD", "EMG-TRI"
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  complaints   Complaint[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Complaint {
  id               String       @id @default(cuid())
  trackingId       String       @unique // e.g. "GN-2026-8942"
  pin              String       // 4-digit security PIN for tracking
  isAnonymous      Boolean      @default(false)
  patientId        String?
  registeredPatient Patient?    @relation(fields: [patientId], references: [id])
  patientName      String?
  patientPhone     String?
  patientEmail     String?
  mrnNumber        String?      // Patient ID / Medical Record Number
  category         Category     @default(OTHER)
  departmentId     String
  department       Department   @relation(fields: [departmentId], references: [id])
  unitId           String?
  unit             Unit?        @relation(fields: [unitId], references: [id])
  targetPersonName String?
  targetPersonRole String?
  incidentDate     DateTime
  location         String
  subject          String
  description      String
  priority         Priority     @default(MEDIUM)
  status           Status       @default(SUBMITTED)
  actionSummary    String?      // Public resolution summary for patient view
  resolvedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  assignedToId     String?
  assignedTo       User?        @relation("AssignedComplaints", fields: [assignedToId], references: [id])
  actions          ComplaintAction[]
  attachments      Attachment[]
  feedback         Feedback?
  notifications    Notification[]
  messages         ComplaintMessage[]
  capa             CapaRecord?
}

model ComplaintAction {
  id          String     @id @default(cuid())
  complaintId String
  complaint   Complaint  @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?      @relation(fields: [actorId], references: [id])
  actionType  ActionType
  description String
  isPublic    Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

model Attachment {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fileUrl     String
  fileName    String
  fileType    String
  fileSize    Int?
  uploadedBy  String    @default("PATIENT")
  createdAt   DateTime  @default(now())
}

model Feedback {
  id          String    @id @default(cuid())
  complaintId String    @unique
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  rating      Int
  comments    String?
  createdAt   DateTime  @default(now())
}

model Notification {
  id          String     @id @default(cuid())
  userId      String?    // null = for central grievance admins, or specific user ID
  complaintId String?
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String     @default("DEPT_UPDATE") // "DEPT_UPDATE", "ASSIGNMENT", "RESOLVED"
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

model ComplaintMessage {
  id             String    @id @default(cuid())
  complaintId    String
  complaint      Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  senderType     String    // "PATIENT" | "STAFF" | "ADMIN"
  senderId       String?   // User ID if staff/admin, null if patient
  senderName     String    // Display name (e.g., "Dr. Ramesh", "Investigating Officer", "Patient")
  message        String
  attachmentUrl  String?
  attachmentName String?
  isRead         Boolean   @default(false)
  createdAt      DateTime  @default(now())
}

model CapaRecord {
  id                String            @id @default(cuid())
  complaintId       String            @unique
  complaint         Complaint         @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  rootCauseCategory RootCauseCategory @default(PROCESS_DEFECT)
  rootCauseAnalysis String            // Detailed narrative of why the failure occurred
  correctiveAction  String            // Immediate remedial fix taken for this specific patient
  preventiveAction  String            // Systemic / hospital-wide change to prevent recurrence
  status            CapaStatus        @default(DRAFT)
  targetReviewDate  DateTime?         // Date by which QA committee audits effectiveness
  qaOfficerName     String?           // Quality Assurance Officer reviewing the CAPA
  qaNotes           String?           // Clinical governance audit notes
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

